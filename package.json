{
  "name": "react-native-barcode-expo",
  "version": "3.0.2",
  "description": "React Native barcode component with Expo support, powered by JsBarcode and react-native-svg.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pthongtaem/react-native-barcode-expo.git"
  },
  "license": "Apache-2.0",
  "source": "src/index.tsx",
  "main": "dist/index.cjs",
  "types": "dist/typescript/commonjs/src/index.d.ts",
  "typings": "dist/typescript/commonjs/src/index.d.ts",
  "scripts": {
    "build": "node scripts/clean-dist.cjs && node scripts/prepare-dist.cjs && bob build",
    "lint": "eslint src test scripts example-expo",
    "typecheck": "tsc --noEmit && tsc --noEmit -p example-expo/tsconfig.json",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.cjs",
    "release:check": "npm run lint && npm run test:package && npm run typecheck"
  },
  "keywords": [
    "react-native",
    "expo",
    "barcode"
  ],
  "author": "Pol Thongtaem <pthongtaem@hotmail.com>",
  "type": "module",
  "dependencies": {
    "jsbarcode": "^3.11.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.69.0 <1.0.0",
    "react-native-svg": ">=13.0.0 <16.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.15.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "react-native-svg": "15.15.4",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.0"
  },
  "packageManager": "yarn@4.18.0",
  "module": "dist/module/index.js",
  "react-native": "src/index.tsx",
  "files": [
    "dist",
    "src"
  ],
  "homepage": "https://github.com/pthongtaem/react-native-barcode-expo#readme",
  "bugs": {
    "url": "https://github.com/pthongtaem/react-native-barcode-expo/issues"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
